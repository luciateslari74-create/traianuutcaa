<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мои Шпоры</title>
    <style>
        body { font-family: sans-serif; padding: 20px; background: #f4f4f9; max-width: 600px; margin: auto; }
        .card { background: white; padding: 15px; margin-bottom: 15px; border-radius: 10px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        input, button { width: 100%; padding: 12px; margin: 8px 0; border-radius: 5px; border: 1px solid #ccc; box-sizing: border-box; font-size: 16px; }
        button { background: #28a745; color: white; border: none; font-weight: bold; cursor: pointer; }
        button:active { background: #218838; }
        img { max-width: 100%; height: auto; border-radius: 5px; display: block; }
        h3 { margin-top: 10px; margin-bottom: 0; color: #333; font-size: 18px; }
        #loading { display: none; color: #555; text-align: center; font-weight: bold; }
    </style>
</head>
<body>

    <h2>Добавить шпору</h2>
    <div class="card">
        <input type="text" id="title" placeholder="Название темы">
        <input type="file" id="photo" accept="image/*" capture="environment">
        <button onclick="uploadCheat()">Добавить шпору</button>
        <div id="loading">Загрузка фото... ⏳</div>
    </div>

    <h2>Список шпор</h2>
    <div id="list"></div>

    <script>
        document.addEventListener("DOMContentLoaded", loadCheats);

        async function uploadCheat() {
            const title = document.getElementById('title').value.trim();
            const fileInput = document.getElementById('photo');
            const loading = document.getElementById('loading');

            if (!title || fileInput.files.length === 0) {
                alert("Заполни название и выбери фото!");
                return;
            }

            const file = fileInput.files[0];
            const formData = new FormData();
            formData.append("image", file);

            loading.style.display = "block";

            try {
                const response = await fetch("https://api.imgbb.com/1/upload?key=6d207e02198a847798d181ace43d83d8", {
                    method: "POST",
                    body: formData
                });
                const data = await response.json();

                if (data.success) {
                    saveCheatData(title, data.data.url);
                } else {
                    alert("Ошибка загрузки.");
                }
            } catch (error) {
                alert("Ошибка интернета!");
            } finally {
                loading.style.display = "none";
            }
        }

        function saveCheatData(title, url) {
            let cheats = JSON.parse(localStorage.getItem('cheats') || '[]');
            cheats.unshift({ title, url });
            localStorage.setItem('cheats', JSON.stringify(cheats));
            
            document.getElementById('title').value = '';
            document.getElementById('photo').value = '';
            loadCheats();
        }

        function loadCheats() {
            const listDiv = document.getElementById('list');
            let cheats = JSON.parse(localStorage.getItem('cheats') || '[]');
            
            listDiv.innerHTML = '';
            cheats.forEach(item => {
                const div = document.createElement('div');
                div.className = 'card';
                div.innerHTML = `<img src="${item.url}" loading="lazy"><h3>${item.title}</h3>`;
                listDiv.appendChild(div);
            });
        }
    </script>
</body>
</html>

